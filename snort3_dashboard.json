    "snort3",
    "ids",
    "mariadb"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "description": "Frontend к таблице snort.snort_alerts. Фильтры сверху + drill-down по кликам в таблицах.",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS",
        "label": "MariaDB",
        "query": "mysql",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "type": "query",
        "name": "priority",
        "label": "Приоритет",
        "datasource": {
          "type": "mysql",
          "uid": "${DS}"
        },
        "query": "SELECT DISTINCT priority FROM snort_alerts ORDER BY 1",
        "definition": "SELECT DISTINCT priority FROM snort_alerts ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "SELECT DISTINCT priority FROM snort_alerts",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "type": "query",
        "name": "class",
        "label": "Классификация",
        "datasource": {
          "type": "mysql",
          "uid": "${DS}"
        },
        "query": "SELECT DISTINCT classification FROM snort_alerts ORDER BY 1",
        "definition": "SELECT DISTINCT classification FROM snort_alerts ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "SELECT DISTINCT classification FROM snort_alerts",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "type": "query",
        "name": "action",
        "label": "Действие",
        "datasource": {
          "type": "mysql",
          "uid": "${DS}"
        },
        "query": "SELECT DISTINCT action FROM snort_alerts ORDER BY 1",
        "definition": "SELECT DISTINCT action FROM snort_alerts ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "SELECT DISTINCT action FROM snort_alerts",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "type": "textbox",
        "name": "ip",
        "label": "IP (src/dst, % = все)",
        "query": "%",
        "current": {
          "text": "%",
          "value": "%"
        },
        "options": [
          {
            "selected": true,
            "text": "%",
            "value": "%"
          }
        ]
      },
      {
        "type": "textbox",
        "name": "sid",
        "label": "SID (% = все)",
        "query": "%",
        "current": {
          "text": "%",
          "value": "%"
        },
        "options": [
          {
            "selected": true,
            "text": "%",
            "value": "%"
          }
        ]
      },
      {
        "type": "textbox",
        "name": "flow",
        "label": "Flow ID (% = все)",
        "query": "%",
        "current": {
          "text": "%",
          "value": "%"
        },
        "options": [
          {
            "selected": true,
            "text": "%",
            "value": "%"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Алертов за период",
      "datasource": {
        "type": "mysql",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS alerts FROM snort_alerts WHERE $__timeFilter(alert_time) AND priority IN ($priority) AND classification IN ($class) AND action IN ($action) AND (src_ip LIKE '$ip' OR dst_ip LIKE '$ip') AND CAST(sig_id AS CHAR) LIKE '$sid' AND CAST(flow_id AS CHAR) LIKE '$flow'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
