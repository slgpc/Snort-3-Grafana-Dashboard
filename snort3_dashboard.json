    {
      "id": 6,
      "type": "table",
      "title": "Группы алертов (клик по SID - детали)",
      "datasource": {
        "type": "mysql",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT generator_id, sig_id, MAX(rule_msg) AS rule_msg, MIN(priority) AS priority, COUNT(*) AS alerts, COUNT(DISTINCT src_ip) AS sources, MAX(alert_time) AS last_seen FROM snort_alerts WHERE $__timeFilter(alert_time) AND priority IN ($priority) AND classification IN ($class) AND action IN ($action) AND (src_ip LIKE '$ip' OR dst_ip LIKE '$ip') AND CAST(sig_id AS CHAR) LIKE '$sid' AND CAST(flow_id AS CHAR) LIKE '$flow' GROUP BY generator_id, sig_id ORDER BY alerts DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sig_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Показать алерты этой группы",
                    "url": "/d/snort3-alerts/snort3-alerts?orgId=1&var-DS=${DS}&${__url_time_range}&var-sid=${__data.fields.sig_id}",
                    "targetBlank": false
                  },
                  {
                    "title": "Описание правила (snort.org)",
                    "url": "https://www.snort.org/rule_docs/${__data.fields.generator_id}-${__data.fields.sig_id}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "priority"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 2,
                      "color": "orange"
                    },
                    {
                      "value": 3,
                      "color": "yellow"
                    },
                    {
                      "value": 4,
                      "color": "blue"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rule_msg"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 360
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "alerts",
            "desc": true
          }
        ]
      },
      "description": "Клик по sig_id открывает меню: фильтр дашборда по группе или описание правила на snort.org."
    },
