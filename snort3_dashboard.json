    {
      "id": 5,
      "type": "timeseries",
      "title": "Алерты во времени по приоритету",
      "datasource": {
        "type": "mysql",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(alert_time,$__interval), CONCAT('P',priority) AS metric, COUNT(*) AS value FROM snort_alerts WHERE $__timeFilter(alert_time) AND priority IN ($priority) AND classification IN ($class) AND action IN ($action) AND (src_ip LIKE '$ip' OR dst_ip LIKE '$ip') AND CAST(sig_id AS CHAR) LIKE '$sid' AND CAST(flow_id AS CHAR) LIKE '$flow' GROUP BY 1,2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "P1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
