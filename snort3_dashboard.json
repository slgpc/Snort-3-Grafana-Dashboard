          "rawSql": "SELECT dst_ip, COUNT(*) AS alerts, COUNT(DISTINCT sig_id) AS signatures, MAX(alert_time) AS last_seen FROM snort_alerts WHERE $__timeFilter(alert_time) AND priority IN ($priority) AND classification IN ($class) AND action IN ($action) AND (src_ip LIKE '$ip' OR dst_ip LIKE '$ip') AND CAST(sig_id AS CHAR) LIKE '$sid' AND CAST(flow_id AS CHAR) LIKE '$flow' GROUP BY dst_ip ORDER BY alerts DESC LIMIT 20"
