          "rawSql": "SELECT alert_time, priority, action, src_ip, src_port, dst_ip, dst_port, protocol, generator_id, sig_id, rule_msg, classification, flow_id, raw_json FROM snort_alerts WHERE $__timeFilter(alert_time) AND priority IN ($priority) AND classification IN ($class) AND action IN ($action) AND (src_ip LIKE '$ip' OR dst_ip LIKE '$ip') AND CAST(sig_id AS CHAR) LIKE '$sid' AND CAST(flow_id AS CHAR) LIKE '$flow' ORDER BY alert_time DESC LIMIT 1000"
